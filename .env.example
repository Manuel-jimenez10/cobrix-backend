# ─────────────────────────────────────────────────────────────
# Cobrix · backend de agentes
# Copia este archivo como .env (local) o pon estas variables en Render.
# Nunca subas el .env a GitHub.
# ─────────────────────────────────────────────────────────────

PORT=8787

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# ⚠️ Service role key: SOLO en el backend, jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (gratis) → https://aistudio.google.com/apikey
# Si se deja vacío, los agentes funcionan con reglas (sin IA).
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Nivel de "pensamiento" del modelo: minimal | low | medium | high (menos = más rápido)
GEMINI_THINKING=low

# Límite de llamadas a IA por usuario (protege la capa gratuita de Gemini)
AI_RATE_LIMIT_PER_10MIN=30

# ── WhatsApp Cloud API (opcional; sin esto se usa el simulador) ──
# Meta for Developers → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=
# Cuenta de WhatsApp Business de Cobrix: ahí se registran los números de las empresas (Ajustes → WhatsApp).
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Inventa una cadena; la misma va en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic → App secret (valida la firma de los webhooks)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_TEMPLATE_AMABLE=cobrix_recordatorio_amable
WHATSAPP_TEMPLATE_FIRME=cobrix_seguimiento_firme
WHATSAPP_TEMPLATE_FINAL=cobrix_aviso_final
