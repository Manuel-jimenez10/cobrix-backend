{
  "name": "cobrix-agents-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de agentes de cobranza de Cobrix: Hono + Vercel AI SDK + Gemini + Supabase + WhatsApp Cloud API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@hono/node-server": "^1.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "ai": "^5.0.0",
    "hono": "^4.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
